# =============================================================================
# RAILWAY LOCAL SIMULATION ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# Used exclusively with infra/railway/docker-compose.railway-sim.yml to verify
# the Railway production architecture locally before cloud deployment.
# Contains non-sensitive throwaway placeholders only.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_sim_test_password
JWT_SECRET_KEY=sim_throwaway_jwt_secret_key_32_chars_min!!

# Frontend published port on Windows host loopback
FRONTEND_HOST_PORT=3000

# Canonical public base URL
PUBLIC_BASE_URL=http://localhost:3000

# Non-production test credentials for operation-service fail-fast validation
BAKONG_ACCOUNT_ID=merchant_sim@bank
BAKONG_TOKEN=sim_dev_token_for_railway_check
BAKONG_MAX_AMOUNT_USD=1.00
