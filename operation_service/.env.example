ENVIRONMENT=local

# Database Connection settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=operation_service_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# Must be IDENTICAL to user_service's JWT_SECRET_KEY / JWT_ALGORITHM, since
# operation_service verifies tokens issued by user_service rather than
# issuing its own.
# In production, this must be a secure random secret of at least 32 characters.
JWT_SECRET_KEY=dev-only-shared-secret-change-me
JWT_ALGORITHM=HS256

CORS_ORIGINS=*

# Bakong KHQR Payment Gateway (Required at startup in non-test environments)
BAKONG_ACCOUNT_ID=
BAKONG_TOKEN=
BAKONG_MERCHANT_NAME=Coffee Shop
BAKONG_MERCHANT_CITY=Phnom Penh
BAKONG_MAX_AMOUNT_USD=1.00
PAYMENT_EXPIRY_MINUTES=15

# Product Image Upload Settings
UPLOAD_DIR=/app/uploads
UPLOAD_MAX_BYTES=5242880
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp
UPLOAD_MAX_DIMENSION=4000
UPLOAD_MAX_PIXELS=16000000
